# Optional. The desk learns and answers with its own playbook when these are empty.
# GitHub Models uses a PAT from the same GitHub account (scope: models).
GITHUB_MODELS_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=

# Protects full phone numbers and the booked/lost buttons. Leave empty only on your machine.
ADMIN_TOKEN=

# Twilio signs webhook posts. Voice and WhatsApp still answer if this is empty.
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=

# Meta WhatsApp Cloud API. Twilio sandbox works without these.
META_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# How often the desk tries a lower-scoring approach so it can keep learning. 0 = always exploit.
LEARN_EPSILON=0.08
PORT=8787
